{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "ninja-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_LINKER": "link",
                "CMAKE_CXX_FLAGS": "/std:c++20 /EHsc /MP /Zi /O2",
                "CMAKE_SYSTEM_NAME": "Windows"
            }
        },
        {
            "name": "vs-base",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/vs/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },

        {
            "name": "ninja-release",
            "displayName": "Ninja + cl.exe (RelWithDebInfo)",
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "ninja-debug",
            "displayName": "Ninja + cl.exe (Debug)",
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CUSTOM_DEFINES": "DEBUG_LOGGING"
            }
        },
        {
            "name": "vs-msbuild",
            "displayName": "Visual Studio",
            "inherits": "vs-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
          "name": "linux-clang-cl",
          "generator": "Ninja",
          "binaryDir": "${sourceDir}/build/ninja/clang-cl-release",
          "environment": {
              "INCLUDE": "/home/fucker/msvc/vc/tools/msvc/14.51.36231/include;/home/fucker/msvc/kits/10/include/10.0.26100.0/ucrt;/home/fucker/msvc/kits/10/include/10.0.26100.0/shared;/home/fucker/msvc/kits/10/include/10.0.26100.0/um;/home/fucker/msvc/kits/10/include/10.0.26100.0/winrt",
              "LIB":"/home/fucker/msvc/vc/tools/msvc/14.51.36231/lib/x64;/home/fucker/msvc/kits/10/lib/10.0.26100.0/ucrt/x64;/home/fucker/msvc/kits/10/lib/10.0.26100.0/um/x64"
          },
          "cacheVariables": {
            "CMAKE_SYSTEM_NAME": "Windows",
            "CMAKE_SYSTEM_PROCESSOR": "AMD64",
            "CMAKE_C_COMPILER": "clang-cl",
            "CMAKE_CXX_COMPILER": "clang-cl",
            "CMAKE_CXX_COMPILER_TARGET": "x86_64-pc-windows-msvc",
            "CMAKE_LINKER": "lld-link",
            "CMAKE_RC_COMPILER": "llvm-rc",
            "CMAKE_MT": "llvm-mt",
            "CMAKE_BUILD_TYPE": "RelWithDebInfo"
          }
        }
        ],
        "buildPresets": [
            {
                "name": "VS-Release",
                "configurePreset": "vs-msbuild",
                "configuration": "Release"
            },
            {
                "name": "VS-Debug",
                "configurePreset": "vs-msbuild",
                "configuration": "Debug"
            },
            {
                "name": "Ninja-Release",
                "configurePreset": "ninja-release"
            },
            {
                "name": "Ninja-Debug",
                "configurePreset": "ninja-debug"
            },
            {
                "name": "Ninja-Release-Clang",
                "configurePreset": "linux-clang-cl"
            }
        ]
    }
